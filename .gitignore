# Gradle: caches and build outputs of every project and of the included build-logic
.gradle/
build/
.kotlin/
# The wrapper jar is committed (checked by gradle-wrapper-validation); every other jar is a build output.
*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDEs
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
.classpath
.project
.settings/
.factorypath

# OS
.DS_Store
Thumbs.db

# Local env files: never committed (secrets pass through the shell, D2 §8.1)
*.local.env

# JVM leftovers
*.class
*.log
hs_err_pid*
replay_pid*

# Archives
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
__pycache__/
.kotlin/
