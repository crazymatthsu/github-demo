# Layer 7 — compose variables of local/cash/source-database/trades-db-to-amps (D5 §6.3): deploy-time knobs only, never a Spring property
# and never a secret (secrets pass through from the shell, D2 §8.1). IMAGE_TAG is rewritten by the
# deploy-dev write-back in *-dev envs (D9 §6.4).
IMAGE_REPO=ghcr.io/crazymatthsu/deephaven-connectors
IMAGE_TAG=local
APP_ENV=local
APP_FLOW=cash
APP_NAME=source-database
APP_INSTANCE=trades-db-to-amps
JAVA_OPTS=-XX:MaxRAMPercentage=60
TZ=UTC
LOG_LEVEL_ROOT=INFO
ACTUATOR_HOST_PORT=18082
MEM_LIMIT=768m
