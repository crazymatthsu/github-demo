# Layer 7 — compose variables of us-dev/cash/source-database/positions-db-to-deephaven (D5 §6.3): deploy-time knobs only, never a Spring property
# and never a secret (secrets pass through from the shell, D2 §8.1). IMAGE_TAG is rewritten by the
# deploy-dev write-back in *-dev envs (D9 §6.4).
IMAGE_REPO=ghcr.io/crazymatthsu/deephaven-connectors
IMAGE_TAG=0.1.0-rc.53
APP_ENV=us-dev
APP_FLOW=cash
APP_NAME=source-database
APP_INSTANCE=positions-db-to-deephaven
JAVA_OPTS=-XX:MaxRAMPercentage=75
TZ=America/New_York
LOG_LEVEL_ROOT=INFO
ACTUATOR_HOST_PORT=18082
MEM_LIMIT=1g
