# versions.env: pinned Kubernetes tools of the kind deployment test, one line per tool so a bump is a
# one-line diff. (Template of the skill gha-ephemeral-test-envs; no placeholders.)
#
# Read by .github/actions/setup-kube-tools (CI installs exactly these, each checked against the SHA-256 sum
# its project publishes) and by kind.sh (version hints). If your CI build image also ships these tools,
# keep both pins equal and bump them together.
#
# The versions below ran green together in the reference pipeline (2026-09); update them to the current
# releases when adopting. No node image here: the cluster runs the node image the kind binary pins (by
# digest) for its release; KIND_NODE_IMAGE overrides it for one run.
# Comments stay on lines of their own; values are plain (no quotes, no spaces).

# kind CLI; its release decides the default node image and so the Kubernetes version.
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# kubectl, within one minor of the node's Kubernetes.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.37.1
# Helm 4: --rollback-on-failure replaces --atomic; helm-release.sh still accepts Helm 3.
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.0
# Schema validation of rendered releases (optional).
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0
