# versions.env: image references of the test stacks, one line each, so a bump is a one-line diff
# (Renovate / Dependabot friendly). (Template of the skill gha-ephemeral-test-envs.)
#
# Placeholders:
#   __POSTGRES_IMAGE__     e.g. docker.io/library/postgres:17.6@sha256:<64 hex>
#                          (digest: docker buildx imagetools inspect docker.io/library/postgres:17.6
#                           --format '{{json .Manifest}}' | jq -r .digest)
#   __TEST_RUNNER_IMAGE__  the image the tests run in: your CI build image, e.g.
#                          ghcr.io/<org>/ci-build:<yyyymmdd>-<n>@sha256:<64 hex>, or a public toolchain image
#                          such as docker.io/library/eclipse-temurin:21-jdk@sha256:<64 hex>
#
# Rules: tag AND digest (the tag for humans, the digest for reproducibility; Docker and Podman pull by
# digest when both are present); fully qualified registries (Podman requires them); comments on lines of
# their own (compose reads this file with --env-file). The environment beats this file: CI sets
# APP_IMAGE (the image under test, by digest) and may override any line, e.g. with a registry mirror.
POSTGRES_IMAGE=__POSTGRES_IMAGE__
TEST_RUNNER_IMAGE=__TEST_RUNNER_IMAGE__
