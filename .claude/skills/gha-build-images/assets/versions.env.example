# versions.env: pins shared by host jobs (setup-kube-tools), laptops and compose files (gha-build-images).
#
# Copy to ci/versions.env (any path works: pass it to setup-kube-tools as `versions-file`). One line per
# pin, so a bump is a one-line diff; Renovate reads the `# renovate:` hint above each line
# (references/pinning.md). Format rules: KEY=value, no quotes, no spaces, comments on lines of their own;
# docker compose --env-file and the setup-kube-tools parser both rely on them.
#
# HELM_VERSION, KUBECTL_VERSION and KIND_VERSION must equal the ARGs of docker/base/ci-build.Dockerfile,
# so the job container and host jobs run the same tools. The PR lint job enforces it:
#   scripts/ci/check-pins.sh docker/base/ci-build.Dockerfile ci/versions.env
#
# Placeholders (grep -n '__[A-Z0-9_]*__'):
#   __IMAGE_NAMESPACE__  registry namespace, lowercase; base images live under <namespace>/base/   ghcr.io/acme

# kind CLI; its release decides the default Kubernetes node image.
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# kubectl, within one minor version of the cluster's Kubernetes.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.37.1
# Helm 4 (--rollback-on-failure replaces --atomic).
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.0
# Schema validation of rendered manifests (host jobs only; not in the CI build image).
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0

# The CI build image for containers started outside the job container: a compose test-runner service,
# `docker run` on a laptop. Start with :latest; once base-image.yml has published, pin the dated tag and
# its digest, <namespace>/base/ci-build:<yyyymmdd>-<n>@sha256:<digest>, and let Renovate bump it.
CI_BUILD_IMAGE=__IMAGE_NAMESPACE__/base/ci-build:latest
