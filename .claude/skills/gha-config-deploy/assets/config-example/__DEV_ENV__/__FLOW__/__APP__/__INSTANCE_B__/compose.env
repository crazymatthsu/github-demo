# Compose variables of __DEV_ENV__/__FLOW__/__APP__/__INSTANCE_B__: deploy-time knobs only (config lint
# allow-list), never an application property and never a secret (secrets come from the host environment).
# APP_* restate the directory path; IMAGE_TAG is rewritten by the deploy-dev write-back.
IMAGE_REPO=__IMAGE_REPO__
IMAGE_TAG=__IMAGE_TAG__
APP_ENV=__DEV_ENV__
APP_FLOW=__FLOW__
APP_NAME=__APP__
APP_INSTANCE=__INSTANCE_B__
JAVA_OPTS=-XX:MaxRAMPercentage=75
TZ=UTC
LOG_LEVEL_ROOT=INFO
HTTP_HOST_PORT=18082
MEM_LIMIT=1g
