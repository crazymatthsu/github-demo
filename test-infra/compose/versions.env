# test-infra/compose/versions.env: image references of the test-infra stacks (D10 §6.10, D8 §6.2).
#
# One line per image, so a dependency bump is a one-line change (Renovate-friendly). Each dependency
# carries a tag for readability and a digest for reproducibility; when both are present, Docker and
# Podman pull by digest. Registries are fully qualified, as Podman requires.
# Enterprise: swap the registry for the JFrog remote and keep the digest, for example
#   artifactory.<company>.com/ghcr-remote/deephaven/server:42.5@sha256:...
# A variable set in the environment wins over this file. System ITs set DEEPHAVEN_IMAGE to our
# deephaven-server image from the same run (DL-26).
# Comments must stay on lines of their own; this file is read by compose --env-file.

# Deephaven Community Core 42.5, ghcr.io/deephaven/server (Jetty/Python flavour), multi-arch index
# resolved 2026-09-27. Keep the Deephaven Java client used by the tests on the same version.
DEEPHAVEN_IMAGE=ghcr.io/deephaven/server:42.5@sha256:bcdf0383631ac8df5446751b2a333a8f90627391900e183b95f84d4e22c65edb

# SQL Server 2022 Developer, amd64 only. 2022-latest resolved to 2022-CU27-ubuntu-22.04 on 2026-09-27.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest@sha256:4402d880dd4c34bfa7d8705e56a86cd6c88da80a1f6bbbe741f999e76264a090

# Apache Kafka 4.3.1 (KRaft, JVM image), multi-arch index resolved 2026-09-27.
KAFKA_IMAGE=docker.io/apache/kafka:4.3.1@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837

# Our build image (docker/base/ci-build, published by base-image.yml). The it-runner test JVM runs in it.
# Move it to a dated <yyyymmdd>-<n> tag once base-image.yml has published one.
CI_BUILD_IMAGE=ghcr.io/crazymatthsu/base/ci-build:latest
