# test-infra/kind/versions.env: pinned Kubernetes tools of demo step 2 (D10 §5.9, D11 §6.4, DL-32).
#
# One line per tool, so a bump is a one-line change. Read by .github/actions/setup-kube-tools (CI installs
# exactly these, checked against the SHA-256 sums each project publishes) and by test-infra/kind/kind.sh
# (version hints). Keep them equal to the pins of the ci-build image (docker/base/ci-build/Dockerfile:
# HELM_VERSION, KUBECTL_VERSION, KIND_VERSION) and bump both together.
#
# No node image here: the cluster runs kind's default node image for KIND_VERSION, which the kind binary
# pins by digest (v0.33.0: kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5).
# KIND_NODE_IMAGE overrides it for one run (README.md).
# Comments stay on lines of their own; values are plain (no quotes, no spaces).

# kind CLI; its release decides the default node image (above).
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# kubectl, within one minor of the node's Kubernetes (v1.37).
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.37.1
# Helm 4: --rollback-on-failure replaces --atomic; the deploy script refuses Helm 3.
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.0
# Schema validation of the rendered releases (config-lint check 12).
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0
