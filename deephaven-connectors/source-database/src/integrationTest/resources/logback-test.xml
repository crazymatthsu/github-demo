<?xml version="1.0" encoding="UTF-8"?>
<!-- Integration-test JVM logging: logback's default is DEBUG, at which gRPC, Netty and Arrow under the Deephaven
     client flood the test output. Warnings and errors only; the tests report through their assertions. -->
<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="console"/>
  </root>
</configuration>
